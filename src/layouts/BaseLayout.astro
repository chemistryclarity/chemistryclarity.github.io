---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Analytics from '../components/seo/Analytics.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

export interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Show the draft banner. */
  draft?: boolean;
}

const { draft = false, ...seo } = Astro.props;

// Site search (Pagefind, built after astro build): index the main content of single content pages only.
// Listing pages, drafts, print views and the search page itself are left out, so results point to real content.
// Key: first path segment, then the number of segments a single content page has.
const searchTypes: Record<string, [number, string]> = {
  chemistry: [2, 'Lesson'],
  quizzes: [2, 'Quiz'],
  flashcards: [2, 'Flashcards'],
  resources: [2, 'Worksheet'],
  explore: [3, 'Explore'],
  learn: [2, 'Subject'],
  news: [2, 'News'],
  notes: [2, 'Notes'],
  videos: [2, 'Video'],
};
const simplePages = new Set(['about', 'editorial-standards', 'contact', 'privacy', 'terms', 'disclaimer', 'connect']);
const segments = Astro.url.pathname.split('/').filter(Boolean);
const rule = searchTypes[segments[0] ?? ''];
const searchType = seo.noindex || draft
  ? undefined
  : rule && segments.length === rule[0]
    ? rule[1]
    : segments.length === 1 && simplePages.has(segments[0])
      ? 'Page'
      : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1524" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <SeoHead {...seo} noindex={seo.noindex || draft} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <p class="print-brand">{site.name} · {new URL(site.url).host}</p>
    {draft && (
      <div class="draft-banner" role="note">
        <div class="container">
          <strong>Draft</strong> — this page is a work in progress and is hidden from search engines.
        </div>
      </div>
    )}
    <main id="main" tabindex="-1" data-pagefind-body={searchType ? '' : undefined} data-pagefind-filter={searchType ? `type:${searchType}` : undefined} data-pagefind-meta={searchType ? `type:${searchType}` : undefined}>
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>

<style>
  .draft-banner {
    background: var(--mistake-bg);
    color: var(--mistake);
    border-bottom: 1px solid var(--mistake);
    font-size: var(--step--1);
    padding-block: var(--space-2);
  }
  main:focus { outline: none; }
  .print-brand { display: none; }
  @media print {
    .draft-banner { display: none; }
    .print-brand {
      display: block;
      font-weight: 700;
      font-size: 10pt;
      color: #0f766e;
      padding-bottom: 2mm;
      margin-bottom: 4mm;
      border-bottom: 2px solid #0f766e;
    }
  }
</style>
