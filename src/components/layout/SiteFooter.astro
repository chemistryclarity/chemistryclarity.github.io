---
import Logo from './Logo.astro';
import { site, newsletterEnabled } from '../../config/site';
import { footerNav } from '../../config/navigation';
import { url } from '../../lib/url';
import { getVisible } from '../../lib/content';

const year = new Date().getFullYear();
const years = year > site.copyrightStart ? `${site.copyrightStart}–${year}` : `${year}`;
// The Explore link appears only once at least one Explore article is published.
const hasExplore = (await getVisible('explore')).length > 0;
const groups = footerNav
  .map((g) => ({ ...g, links: g.links.filter((l) => l.href !== '/explore/' || hasExplore) }))
  .map((g) =>
    g.heading === 'Learn' && newsletterEnabled ? { ...g, links: [...g.links, { label: 'Newsletter', href: '/newsletter/' }] } : g,
  );
const socials = Object.entries(site.social).filter(([, href]) => href);
const socialLabels: Record<string, string> = {
  youtube: 'YouTube', instagram: 'Instagram', tiktok: 'TikTok', facebook: 'Facebook',
  x: 'X', threads: 'Threads', linkedin: 'LinkedIn', pinterest: 'Pinterest',
};
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo size="sm" />
      <p class="muted">{site.tagline} Free, carefully checked explanations for anyone learning chemistry.</p>
      {socials.length > 0 && (
        <ul class="site-footer__social" role="list">
          {socials.map(([key, href]) => <li><a href={href} rel="me noopener">{socialLabels[key] ?? key}</a></li>)}
        </ul>
      )}
    </div>
    {groups.map((group) => (
      <nav aria-label={group.heading}>
        <h2 class="site-footer__heading">{group.heading}</h2>
        <ul role="list">
          {group.links.map((link) => <li><a href={url(link.href)}>{link.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container site-footer__legal">
    <p>© {years} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    font-size: var(--step--1);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .site-footer__brand { grid-column: 1 / -1; max-width: 22rem; }
  .site-footer__brand p { margin-top: var(--space-3); }
  @media (min-width: 48rem) {
    .site-footer__grid { grid-template-columns: 2fr repeat(3, 1fr); }
    .site-footer__brand { grid-column: auto; }
  }
  .site-footer__heading {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  ul { list-style: none; padding: 0; }
  li + li { margin-top: var(--space-2); }
  a { color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  .site-footer__social { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-4); }
  .site-footer__social li + li { margin-top: 0; }
  .site-footer__legal {
    border-top: 1px solid var(--border);
    padding-block: var(--space-4);
    color: var(--muted);
  }
</style>
