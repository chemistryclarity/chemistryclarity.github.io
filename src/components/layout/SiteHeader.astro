---
import Logo from './Logo.astro';
import { mainNav } from '../../config/navigation';
import { url } from '../../lib/url';
import { getAreas, getTopics, getVisible, groupByArea } from '../../lib/content';
import { exploreSections, exploreSectionIds } from '../../config/explore';
import { socialLinks } from '../../config/socialLinks';

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));

// Sub-menus that open downward under each main tab. Subject lists are built from the
// published lessons, so a new subject appears in the menu as soon as it has a lesson.
type Link = { label: string; href: string; external?: boolean };
const [areas, topics, decks, quizzes, notes, videos] = await Promise.all([
  getAreas(), getTopics(), getVisible('flashcards'), getVisible('quizzes'), getVisible('notes'), getVisible('videos'),
]);
const subjects = areas.filter((a) => topics.some((t) => t.data.area.id === a.id));
// The Explore tab appears only once at least one Explore article is published.
const exploreArticles = await getVisible('explore');
const exploreLive = exploreArticles.length > 0;
const exploreLiveSections = exploreSectionIds.filter((id) => exploreArticles.some((a) => a.data.section === id));
const navItems = mainNav.filter((i) => i.href !== '/explore/' || exploreLive);
const deckGroups = (await groupByArea(decks, 'flashcards')).groups;
const quizGroups = (await groupByArea(quizzes, 'quiz')).groups;

const children: Record<string, Link[]> = {
  '/learn/': [
    { label: 'All subjects', href: '/learn/' },
    ...subjects.map((a) => ({ label: a.data.title, href: `/learn/${a.id}/` })),
  ],
  '/flashcards/': [
    { label: 'All flashcards', href: '/flashcards/' },
    ...deckGroups.map((g) => ({ label: g.area.data.title, href: `/flashcards/#${g.area.id}` })),
  ],
  '/quizzes/': [
    { label: 'All quizzes', href: '/quizzes/' },
    ...quizGroups.map((g) => ({ label: g.area.data.title, href: `/quizzes/#${g.area.id}` })),
  ],
  '/resources/': [
    { label: 'Free worksheets', href: '/resources/#free' },
    { label: 'Premium Mastery Packs', href: '/resources/#premium' },
    ...(notes.length ? [{ label: 'Lecture notes', href: '/notes/' }] : []),
    ...(videos.length ? [{ label: 'Videos', href: '/videos/' }] : []),
  ],
  '/explore/': [
    { label: 'All special topics', href: '/explore/' },
    ...exploreLiveSections.map((id) => ({ label: exploreSections[id].menuLabel, href: `/explore/${id}/` })),
  ],
  '/news/': [
    { label: 'Latest news', href: '/news/' },
    { label: 'Upcoming events', href: '/news/#events' },
  ],
  '/about/': [
    { label: 'About Chemistry Clarity', href: '/about/' },
    { label: 'Editorial standards', href: '/editorial-standards/' },
    { label: 'Contact', href: '/contact/' },
  ],
  // Social profiles open in a new tab; only those with an address are listed.
  '/connect/': [
    { label: 'All ways to connect', href: '/connect/' },
    ...socialLinks().map((p) => ({ label: p.label, href: p.href, external: true })),
  ],
};
const wide = new Set(['/learn/', '/flashcards/', '/quizzes/']);
const alignEnd = new Set(['/news/', '/about/', '/connect/']);
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />
    <a class="search-link" href={url('/search/')} aria-label="Search the site" aria-current={isActive('/search/') ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      <span class="search-link__text">Search</span>
    </a>
    <nav aria-label="Main">
      <details class="menu">
        <summary class="menu__toggle">
          <span class="menu__icon" aria-hidden="true"></span>
          Menu
        </summary>
        <ul class="menu__list" role="list">
          {navItems.map((item) => {
            const subs = children[item.href];
            if (!subs) {
              return (
                <li>
                  <a class="menu__link" href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                </li>
              );
            }
            return (
              <li>
                <details class:list={['dd', { 'dd--wide': wide.has(item.href), 'dd--end': alignEnd.has(item.href) }]}>
                  <summary class="menu__link dd__toggle" aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.short ? (<><span class="lbl-full">{item.label}</span><span class="lbl-short">{item.short}</span></>) : item.label}<span class="dd__chev" aria-hidden="true"></span>
                  </summary>
                  <ul class="dd__panel" role="list">
                    {subs.map((s) => (
                      <li>{s.external
                        ? <a href={s.href} target="_blank" rel="me noopener">{s.label}<span class="ext" aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
                        : <a href={url(s.href)}>{s.label}</a>}</li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: var(--space-4);
  }

  .site-header__inner > nav { flex: none; }
  .search-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
  }
  .search-link:hover, .search-link[aria-current='page'] { color: var(--accent); border-color: var(--accent); }
  .search-link__text { display: none; }
  @media (min-width: 30rem) { .search-link__text { display: inline; } }
  @media (min-width: 80rem) {
    .search-link { order: 3; margin-left: 0; border-color: transparent; background: none; padding: 0 var(--space-2); }
    .search-link__text { display: none; }
    .site-header__inner > nav { margin-left: auto; }
  }
  @media (min-width: 90rem) { .search-link__text { display: inline; } }
  .lbl-short { display: none; }
  .ext { font-size: 0.85em; color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Smaller desktops (1280–1440 px): tighter tabs, short labels, search icon only */
  @media (min-width: 80rem) and (max-width: 89.99rem) {
    .site-header__inner { gap: var(--space-2); }
    .menu__link { padding-inline: 0.5rem !important; }
    .search-link { padding: 0 0.35rem; }
    .lbl-full { display: none; }
    .lbl-short { display: inline; }
  }

  /* Mobile: disclosure menu with sub-menus that open downward (works without JavaScript) */
  .menu { position: relative; }
  .menu__toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--step--1);
    cursor: pointer;
    background: var(--surface);
  }
  .menu__toggle::-webkit-details-marker,
  .dd__toggle::-webkit-details-marker { display: none; }
  .menu__icon,
  .menu__icon::before,
  .menu__icon::after {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
  }
  .menu__icon::before, .menu__icon::after { content: ''; position: absolute; }
  .menu__icon::before { top: -5px; }
  .menu__icon::after { top: 5px; }

  .menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: min(20rem, calc(100vw - 2rem));
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: var(--space-2);
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .menu__link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }
  .menu__link:hover { background: var(--surface-2); }
  .menu__link[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
  .dd__chev {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.15s;
    margin-left: auto;
  }
  .dd[open] .dd__chev { transform: translateY(2px) rotate(-135deg); }
  .dd__panel {
    list-style: none;
    padding: 0 0 var(--space-2) var(--space-3);
    margin: 0;
  }
  .dd__panel a {
    display: block;
    padding: 0.55rem var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 550;
  }
  .dd__panel a:hover { background: var(--surface-2); color: var(--accent); }
  .dd__panel li:first-child a { font-weight: 700; color: var(--ink); }

  /* Desktop: horizontal tabs; each tab opens a panel downward */
  @media (min-width: 80rem) {
    .menu__toggle { display: none; }
    .menu__list {
      position: static;
      display: flex;
      gap: var(--space-1);
      width: auto;
      max-height: none;
      overflow: visible;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }
    .menu__link { padding: 0.5rem 0.75rem; }
    .dd__chev { margin-left: 0.2rem; }
    .dd { position: relative; }
    .dd__panel {
      position: absolute;
      left: 0;
      top: calc(100% + 0.4rem);
      min-width: 15rem;
      padding: var(--space-2);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-2);
      z-index: 60;
    }
    .dd--wide .dd__panel { display: grid; grid-template-columns: repeat(2, minmax(13rem, 1fr)); column-gap: var(--space-2); min-width: 30rem; }
    .dd--wide .dd__panel li:first-child { grid-column: 1 / -1; }
    .dd--end .dd__panel { left: auto; right: 0; }
  }
</style>

<script>
  // Desktop: keep the main menu open. Mobile: close it after choosing a link or pressing Escape.
  // Sub-menus: only one open at a time; click outside or press Escape to close.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const dds = Array.from(document.querySelectorAll<HTMLDetailsElement>('.dd'));
  if (menu) {
    const mq = window.matchMedia("(min-width: 80rem)");
    const sync = () => { menu.open = mq.matches; dds.forEach((d) => (d.open = false)); };
    sync();
    mq.addEventListener('change', sync);
    dds.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) dds.forEach((o) => { if (o !== d) o.open = false; });
      }),
    );
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (mq.matches && !dds.some((d) => d.contains(target))) dds.forEach((d) => (d.open = false));
      // Following a link inside a panel: close the panels (and the mobile menu).
      if (target.closest('.dd__panel a')) {
        dds.forEach((d) => (d.open = false));
        if (!mq.matches) menu.open = false;
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openDd = dds.find((d) => d.open);
      if (openDd) {
        openDd.open = false;
        openDd.querySelector('summary')?.focus();
      } else if (!mq.matches && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
