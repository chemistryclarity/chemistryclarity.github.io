---
/**
 * Web version of a worksheet data box (src/components/print/DataBox.astro) for the question preview on resource pages.
 */
import { renderInline } from '../../lib/inline-math';

export interface Props {
  title?: string;
  items: string[];
  note?: string;
}
const { title = 'Data', items, note } = Astro.props;
---

<aside class="data">
  <p class="data__title">{title}</p>
  <ul role="list">{items.map((i) => <li set:html={renderInline(i)} />)}</ul>
  {note && <p class="data__note">{note}</p>}
</aside>

<style>
  .data { border: 1px solid var(--border-strong, var(--border)); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-block: var(--space-4); background: var(--bg); }
  .data__title { font-weight: 700; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-1); }
  ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); }
  .data__note { font-size: var(--step--1); margin-top: var(--space-2); }
</style>
