---
/** Marks premium (paid) content. Uses text + icon, not colour alone. */
---

<span class="badge premium">
  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2 2.4 5 5.4.6-4 3.7 1.1 5.4L10 14l-4.9 2.7 1.1-5.4-4-3.7 5.4-.6Z" fill="currentColor" /></svg>
  Premium
</span>

<style>
  .premium { border-color: var(--hue-amber); color: var(--hue-amber); background: var(--mistake-bg); }
  svg { width: 0.9em; height: 0.9em; }
</style>
