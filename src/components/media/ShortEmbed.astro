---
/**
 * Click-to-play vertical YouTube Short (9:16), for the side column of Explore articles.
 * Nothing is loaded from YouTube until the visitor presses play; uses the privacy-enhanced
 * (youtube-nocookie.com) player. Below the player, a link to watch it on YouTube.
 */
import { url } from '../../lib/url';

/** Posters stored on the site: public/images/shorts/<id>.jpg (listed at build time). */
const posters = Object.keys(import.meta.glob('/public/images/shorts/*.jpg'));

export interface Props {
  /** The Short's video ID, e.g. "8N2x6Bp3iTo" from youtube.com/shorts/8N2x6Bp3iTo. */
  id: string;
  title: string;
}
const { id, title } = Astro.props;
/** Optional poster stored on the site (public/images/shorts/<id>.jpg, e.g. the Short's vertical thumbnail). */
const poster = posters.includes(`/public/images/shorts/${id}.jpg`) ? url(`/images/shorts/${id}.jpg`) : null;
---

<div class="short no-print">
  <p class="short__title">Watch the 1-minute video</p>
  <div class="short__frame">
    <button type="button" class:list={['short__poster', { 'short__poster--image': poster }]} data-short-id={id} data-title={title}>
      {poster && <img src={poster} alt="" width="512" height="910" loading="lazy" decoding="async" />}
      <span class="short__play" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5Z" fill="currentColor" /></svg>
      </span>
      <span class:list={['short__label', { 'visually-hidden': poster }]}>Play video: {title}</span>
    </button>
  </div>
  <p class="short__note">
    Pressing play loads the video from YouTube.{' '}
    <a href={`https://www.youtube.com/shorts/${id}`} target="_blank" rel="noopener">Watch on YouTube</a>
  </p>
</div>

<style>
  .short { margin: var(--space-4) 0 var(--space-5); }
  .short__poster--image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .short__poster.short__poster--image { justify-content: flex-end; padding-bottom: 9%; }
  .short__poster--image .short__play { position: relative; width: 3.25rem; height: 3.25rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .short__title { margin: 0 0 var(--space-2); font-weight: 650; font-size: var(--step--1); }
  .short__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    max-width: 16rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0e1524;
  }
  .short__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 0;
    color: #fff;
    font: inherit;
    text-align: center;
    cursor: pointer;
    background:
      radial-gradient(20rem 16rem at 80% 0%, rgb(45 212 191 / 0.3), transparent 60%),
      repeating-linear-gradient(60deg, rgb(255 255 255 / 0.03) 0 2px, transparent 2px 28px),
      #14213d;
  }
  .short__play {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    transition: transform 0.15s;
  }
  .short__play svg { width: 1.9rem; height: 1.9rem; margin-left: 0.2rem; }
  .short__poster:hover .short__play { transform: scale(1.07); }
  .short__poster:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .short__label { font-weight: 650; font-size: var(--step--1); }
  .short__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .short__note { margin-top: var(--space-2); font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 47.99rem) { .short__frame { max-width: 13rem; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-short-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      const id = encodeURIComponent(button.dataset.shortId ?? '');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = button.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      button.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
