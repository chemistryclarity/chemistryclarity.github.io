---
/** Subject-area card styled like a periodic-table tile. */
import type { CollectionEntry } from 'astro:content';
import { routes } from '../../lib/url';

export interface Props {
  area: CollectionEntry<'areas'>;
  topicCount: number;
}
const { area, topicCount } = Astro.props;
const { title, code, description, order, hue } = area.data;
const countLabel = topicCount === 0 ? 'Coming soon' : `${topicCount} ${topicCount === 1 ? 'lesson' : 'lessons'}`;
---

<a class="tile" href={routes.area(area.id)} style={`--tile-hue: var(--hue-${hue})`}>
  <span class="tile__element" aria-hidden="true">
    <span class="tile__number">{order}</span>
    <span class="tile__code">{code}</span>
  </span>
  <span class="tile__body">
    <span class="tile__title">{title}</span>
    <span class="tile__desc">{description}</span>
    <span class="tile__count">{countLabel}</span>
  </span>
</a>

<style>
  .tile {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    height: 100%;
  }
  .tile:hover {
    color: var(--ink);
    border-color: var(--tile-hue);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }
  .tile__element {
    flex: none;
    width: 3.6rem;
    height: 3.9rem;
    border: 2px solid var(--tile-hue);
    border-radius: var(--radius-sm);
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 0.25rem 0.35rem;
    color: var(--tile-hue);
    background: color-mix(in srgb, var(--tile-hue) 8%, var(--surface));
  }
  .tile__number { font-size: 0.7rem; font-weight: 600; line-height: 1; }
  .tile__code { font-size: 1.25rem; font-weight: 750; align-self: center; justify-self: center; letter-spacing: -0.02em; }
  .tile__body { display: grid; gap: 0.3rem; }
  .tile__title { font-weight: 650; line-height: 1.3; }
  .tile__desc { font-size: var(--step--1); color: var(--muted); line-height: 1.45; }
  .tile__count { font-size: var(--step--1); font-weight: 600; color: var(--ink-soft); margin-top: 0.15rem; }
</style>
