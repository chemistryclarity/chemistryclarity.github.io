---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TopicCard from '../../components/cards/TopicCard.astro';
import { getAll, getAreas, getTopicsByArea, isVisible, levelLabel, resourceTypeLabel } from '../../lib/content';
import { routes, url } from '../../lib/url';

// Published practice material, for the "Practise" links (drafts are never linked).
const visibleIds = async (c: 'flashcards' | 'quizzes') => new Set((await getAll(c)).filter(isVisible).map((e) => e.id));
const [flashcardIds, quizIds] = await Promise.all([visibleIds('flashcards'), visibleIds('quizzes')]);
const resourceById = new Map((await getAll('resources')).filter(isVisible).map((r) => [r.id, r]));

export const getStaticPaths = (async () => {
  const areas = await getAreas();
  return areas.map((area) => ({ params: { area: area.id }, props: { area } }));
}) satisfies GetStaticPaths;

const { area } = Astro.props;
const topics = await getTopicsByArea(area.id);
const levels = (['beginner', 'intermediate', 'advanced'] as const)
  .map((level) => ({ level, items: topics.filter((t) => t.data.level === level) }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  title={`${area.data.title} — Chemistry Lessons`}
  description={`${area.data.description} Simple explanations, worked examples and practice.`}
  path={`/learn/${area.id}/`}
  noindex={topics.length === 0}
>
  <div class="container section section--tight" style={`--area-hue: var(--hue-${area.data.hue})`}>
    <Breadcrumbs items={[{ label: 'Learn', href: '/learn/' }, { label: area.data.title }]} />
    <header class="section-head page-head">
      <p class="eyebrow area-eyebrow">Subject area {area.data.order}</p>
      <h1>{area.data.title}</h1>
      <p class="lead">{area.data.description}</p>
    </header>

    {levels.length === 0 ? (
      <div class="empty">
        <p><strong>Lessons for this area are on the way.</strong></p>
        <p class="muted">In the meantime, <a href={routes.learn()}>explore the other subject areas</a>.</p>
      </div>
    ) : (
      levels.map((group) => (
        <section class="level-group" aria-labelledby={`level-${group.level}`}>
          <h2 id={`level-${group.level}`}>{levelLabel[group.level]}</h2>
          <ul class="cards" role="list">
            {group.items.map((topic) => <li><TopicCard topic={topic} detailed /></li>)}
          </ul>
        </section>
      ))
    )}
    {topics.length > 0 && (
      <section class="practise" aria-labelledby="practise-h">
        <h2 id="practise-h">Practise {area.data.title.toLowerCase()}</h2>
        <p class="muted">Check your understanding with free flashcards, quizzes and printable worksheets for each lesson.</p>
        <ul class="practise__list" role="list">
          {topics.map((t) => (
            <li>
              <a class="practise__topic" href={routes.topic(t.id)}>{t.data.title}</a>
              <span class="practise__links">
                {t.data.flashcards && flashcardIds.has(t.data.flashcards.id) && <a href={url(`/flashcards/${t.data.flashcards.id}/`)}>Flashcards</a>}
                {t.data.quiz && quizIds.has(t.data.quiz.id) && <a href={url(`/quizzes/${t.data.quiz.id}/`)}>Quiz</a>}
                {t.data.resources.map((r) => resourceById.get(r.id)).filter((r) => r !== undefined).map((r) => (
                  <a href={url(`/resources/${r.id}/`)}>{resourceTypeLabel[r.data.type]}</a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .page-head { margin-top: var(--space-4); }
  .page-head .lead { margin-top: var(--space-3); }
  .area-eyebrow { color: var(--area-hue); }
  .level-group + .level-group { margin-top: var(--space-7); }
  .level-group h2 { font-size: var(--step-2); margin-bottom: var(--space-4); }
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .practise { margin-top: var(--space-8, var(--space-7)); max-width: var(--measure); }
  .practise h2 { font-size: var(--step-2); }
  .practise > p { margin-top: var(--space-2); }
  .practise__list { list-style: none; padding: 0; margin-top: var(--space-4); display: grid; gap: var(--space-2); }
  .practise__list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-1) var(--space-4); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border); }
  .practise__topic { font-weight: 600; }
  .practise__links { display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--step--1); }
  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 40rem;
  }
</style>
