---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import UsedIn from '../../components/layout/UsedIn.astro';
import LevelBadge from '../../components/cards/LevelBadge.astro';
import MathStyles from '../../components/lesson/MathStyles.astro';
import Quiz from '../../components/learning/Quiz.astro';
import VideoEmbed from '../../components/media/VideoEmbed.astro';
import { getEntry } from 'astro:content';
import { getAll, getTopicsUsing, isDraft, isVisible } from '../../lib/content';

export const getStaticPaths = (async () => {
  const quizzes = await getAll('quizzes');
  return quizzes.map((quiz) => ({ params: { quiz: quiz.id }, props: { quiz } }));
}) satisfies GetStaticPaths;

const { quiz } = Astro.props;
const topics = await getTopicsUsing('quiz', quiz.id);
const description = quiz.data.description ?? `${quiz.data.questions.length}-question quiz on ${quiz.data.title}, with explanations.`;
const videoEntry = quiz.data.video ? await getEntry(quiz.data.video) : undefined;
const video = videoEntry && videoEntry.data.videoId && (isVisible(videoEntry) || isDraft(quiz)) ? videoEntry : undefined;
---

<BaseLayout title={quiz.data.title} description={description} path={`/quizzes/${quiz.id}/`} draft={isDraft(quiz)}>
  <MathStyles />
  <div class="container section section--tight narrow">
    <PageHeader crumbs={[{ label: 'Quizzes', href: '/quizzes/' }, { label: quiz.data.title }]} title={quiz.data.title} lead={quiz.data.description}>
      <span class="badge">{quiz.data.questions.length} questions</span>
      <LevelBadge level={quiz.data.level} />
    </PageHeader>
    <Quiz quiz={quiz} />
    {video && (
      <section class="video-quiz" aria-labelledby="video-quiz-h">
        <h2 id="video-quiz-h">Prefer to watch? Try the video quiz</h2>
        <p class="muted">{video.data.description}</p>
        <VideoEmbed video={video} />
      </section>
    )}
    <UsedIn topics={topics} />
  </div>
</BaseLayout>

<style>
  .narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }
  .video-quiz { margin-top: var(--space-7); }
  .video-quiz h2 { font-size: var(--step-1); }
  .video-quiz > p { margin: var(--space-2) 0 var(--space-4); }
</style>
