---
/** Simple pages: every file in src/content/pages/ becomes /<file-name>/. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={page.data.title} description={page.data.description} path={`/${page.id}/`}>
  <article class="container section section--tight">
    <Breadcrumbs items={[{ label: page.data.title }]} />
    <header class="head">
      <h1>{page.data.title}</h1>
      {page.data.updated && <p class="muted">Last updated {fmtDate(page.data.updated)}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .head { margin-block: var(--space-4) var(--space-6); }
  .head p { margin-top: var(--space-2); font-size: var(--step--1); }
</style>
