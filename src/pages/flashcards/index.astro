---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Accordion from '../../components/layout/Accordion.astro';
import LevelBadge from '../../components/cards/LevelBadge.astro';
import { getVisible, isDraft, groupByArea } from '../../lib/content';
import { url } from '../../lib/url';

const decks = await getVisible('flashcards');
const { groups, other } = await groupByArea(decks, 'flashcards');
const sections = [
  ...groups.map((g) => ({ id: g.area.id, title: g.area.data.title, items: g.items })),
  ...(other.length ? [{ id: 'other', title: 'More decks', items: other }] : []),
];
const plural = (n: number) => `${n} deck${n === 1 ? '' : 's'}`;
---

<BaseLayout
  title="Chemistry Flashcards"
  description="Free chemistry flashcards for quick revision: flip, shuffle and test yourself on key definitions and ideas."
  path="/flashcards/"
  noindex={decks.every(isDraft)}
>
  <div class="container section section--tight">
    <PageHeader
      crumbs={[{ label: 'Flashcards' }]}
      eyebrow="Practice"
      title="Flashcards"
      lead="Quick-fire revision. Choose a subject to see its decks, then flip the cards to test yourself."
    />
    {sections.map((s) => (
      <Accordion id={s.id} title={s.title} count={plural(s.items.length)}>
        <ul class="list" role="list">
          {s.items.map((deck) => (
            <li class="item">
              <h2><a href={url(`/flashcards/${deck.id}/`)}>{deck.data.title}</a></h2>
              <div class="meta">
                <span class="badge">{deck.data.cards.length} cards</span>
                <LevelBadge level={deck.data.level} />
                {isDraft(deck) && <span class="badge badge--draft">Draft</span>}
              </div>
            </li>
          ))}
        </ul>
      </Accordion>
    ))}
    {decks.length === 0 && <p class="muted">Flashcard decks are on the way.</p>}
  </div>
</BaseLayout>

<style>
  .list { list-style: none; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .item { padding: var(--space-4); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); }
  .item h2 { font-size: var(--step-0); }
  .item a { color: var(--ink); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
</style>
