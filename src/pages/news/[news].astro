---
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import MathStyles from '../../components/lesson/MathStyles.astro';
import { lessonComponents } from '../../components/lesson';
import { getAll, isDraft, isVisible } from '../../lib/content';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const news = await getAll('news');
  return news.map((n) => ({ params: { news: n.id }, props: { item: n } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);
const topics = (await getEntries(data.topics)).filter(isVisible);
const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={data.title} description={data.summary} path={`/news/${item.id}/`} type="article" draft={isDraft(item)}>
  <MathStyles />
  <div class="container section section--tight narrow">
    <PageHeader crumbs={[{ label: 'News', href: '/news/' }, { label: data.title }]} eyebrow="News" title={data.title} lead={data.summary}>
      <time datetime={data.date.toISOString().slice(0, 10)}>{fmtDate(data.date)}</time>
      {data.updated && <span class="muted">· Updated {fmtDate(data.updated)}</span>}
    </PageHeader>

    {item.body?.trim() && (
      <article class="prose">
        <Content components={lessonComponents} />
      </article>
    )}

    {data.links.length > 0 && (
      <section class="box" aria-labelledby="sources">
        <h2 id="sources">Read more</h2>
        <ul role="list">
          {data.links.map((l) => (
            <li><a href={l.url} rel="noopener">{l.label}<span aria-hidden="true"> ↗</span></a></li>
          ))}
        </ul>
      </section>
    )}

    {topics.length > 0 && (
      <section class="box" aria-labelledby="learn">
        <h2 id="learn">Learn the chemistry</h2>
        <ul role="list">
          {topics.map((t) => (
            <li><a href={url(`/chemistry/${t.id}/`)}>{t.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="back"><a href={url('/news/')}>← All news</a></p>
  </div>
</BaseLayout>

<style>
  .narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }
  .box { margin-top: var(--space-6); padding: var(--space-5); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .box h2 { font-size: var(--step-0); }
  .box ul { list-style: none; padding: 0; margin-top: var(--space-2); display: grid; gap: var(--space-2); }
  .box a { font-weight: 600; overflow-wrap: anywhere; }
  .back { margin-top: var(--space-6); }
</style>
